# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# --- Backend ---

# Long, random secret used to sign session cookies. Required unless
# DEBUG=true. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# SQLAlchemy database URL. A relative sqlite:/// path is resolved against
# the Flask instance folder (instance/), which is the directory mounted as
# a volume in docker-compose.yml, so data survives container restarts.
# Point this at Postgres/MySQL for a heavier deployment instead, e.g.
# postgresql://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///project.db

# Enables Flask debug mode and relaxes the FLASK_SECRET_KEY requirement.
# Never set this to true in production.
DEBUG=True

# Comma-separated list of origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3000

# Set to True once the app is served over HTTPS (e.g. behind the production
# nginx reverse proxy). Browsers drop "Secure" cookies over plain HTTP, so
# keep this False for local http://localhost development.
SESSION_COOKIE_SECURE=False

# --- Frontend ---

# Base URL the Next.js app uses to reach the API. Baked in at build time
# (Next.js requires NEXT_PUBLIC_* vars at build time, not just runtime).
NEXT_PUBLIC_API_URL=http://localhost:5000
