# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed.

# --- Backend ---

# Long, random secret used to sign session cookies. Required unless
# DEBUG=true. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Credentials for the `db` (Postgres) service in docker-compose.yml. Only
# used by that service and by DATABASE_URL below - change PASSWORD before
# using this anywhere other than local dev.
POSTGRES_USER=planer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=planer_pro

# SQLAlchemy database URL. Defaults to the docker-compose `db` service
# above (host "db" is the service name on the compose network, not
# localhost). For a relative sqlite:/// path instead (e.g. for running the
# backend outside Docker without a local Postgres), the path is resolved
# against the Flask instance folder (instance/), which is the directory
# mounted as a volume in docker-compose.yml, so data survives container
# restarts - e.g. DATABASE_URL=sqlite:///project.db
DATABASE_URL=postgresql://planer:change-me@db:5432/planer_pro

# Enables Flask debug mode and relaxes the FLASK_SECRET_KEY requirement.
# Never set this to true in production.
DEBUG=True

# Comma-separated list of origins allowed to call the API with credentials.
ALLOWED_ORIGINS=http://localhost:3000

# Set to True once the app is served over HTTPS (e.g. behind the production
# nginx reverse proxy). Browsers drop "Secure" cookies over plain HTTP, so
# keep this False for local http://localhost development.
SESSION_COOKIE_SECURE=False

# Outgoing mail (email verification codes, password reset codes). All
# optional - if SMTP_HOST is left blank, emails are logged instead of sent,
# so registration/verification/reset all work locally without any of this
# configured. Set these once you have a real SMTP provider (SendGrid,
# Mailgun, a plain Gmail app password, etc.) - any standard SMTP endpoint
# works, nothing provider-specific is hardcoded.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=True
MAIL_FROM=PlannerPro <no-reply@planerpro.local>

# Flask-Limiter's storage backend. Leave unset (defaults to in-memory) for
# a single gunicorn worker, which is what this repo runs today - in-memory
# limits are per-process, so they silently stop being accurate the moment
# more than one worker/instance is running. Before scaling to multiple
# workers, point this at Redis instead, e.g. redis://redis:6379/0 (also
# needs the `redis` package added to requirements.txt and a redis service
# added to docker-compose.yml - neither is done yet since nothing uses it
# at the current single-worker scale).
RATELIMIT_STORAGE_URI=

# --- Frontend ---

# Base URL the Next.js app uses to reach the API. Baked in at build time
# (Next.js requires NEXT_PUBLIC_* vars at build time, not just runtime).
NEXT_PUBLIC_API_URL=http://localhost:5000
